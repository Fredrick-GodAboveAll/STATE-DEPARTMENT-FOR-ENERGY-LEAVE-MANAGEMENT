<!-- views/employees/add-employee.ejs -->
<div class="card bg-body-tertiary dark__bg-opacity-50 mb-3">
  <div class="card-body p-3">
    <p class="fs-10 mb-0">
      <a href="/employees">
        Bulk Upload Employees, <strong><%= userFirstName %></strong> <%= userLastName %>
      </a>
    </p>
  </div>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0">Upload CSV File</h5>
      </div>
      <div class="card-body">
        <!-- File Upload FORM -->
        <!-- Change this line in add-employee.ejs -->

<!-- CRITICAL FIX: Change form action from /bulk-upload to /employees/bulk-upload -->

<form action="/employees/bulk-upload" method="POST" enctype="multipart/form-data" id="uploadForm">
  <div class="text-center p-4 border-dashed rounded-3 bg-light">
    <span class="fas fa-file-csv fa-3x text-primary mb-3"></span>
    <h5 class="mb-3">Upload Employee CSV</h5>
    
    <input type="file" name="csvFile" id="csvFile" class="form-control" accept=".csv" required>
    
    <div class="mt-3">
      <button type="submit" class="btn btn-primary" id="uploadBtn">
        <span class="fas fa-upload me-2"></span>
        Upload & Import
      </button>
    </div>
  </div>
</form>

        <!-- Simple Progress (for form submission) -->
        <div class="mt-3" id="progress" style="display: none;">
          <div class="alert alert-info">
            <div class="d-flex align-items-center">
              <span class="fas fa-sync-alt fa-spin me-2"></span>
              <div>
                Uploading and processing CSV file...
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">CSV Format</h5>
      </div>
      <div class="card-body">
        <!-- Same format table as before... -->
        <!-- Keep your existing format table here -->
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('uploadForm');
  const progress = document.getElementById('progress');
  
  form.addEventListener('submit', function(e) {
    const fileInput = document.getElementById('csvFile');
    
    if (!fileInput.files[0]) {
      e.preventDefault();
      alert('Please select a CSV file first');
      return;
    }
    
    if (!fileInput.files[0].name.endsWith('.csv')) {
      e.preventDefault();
      alert('Please upload a CSV file');
      return;
    }
    
    // Show progress indicator
    if (progress) {
      progress.style.display = 'block';
    }
    document.getElementById('uploadBtn').disabled = true;
    document.getElementById('uploadBtn').innerHTML = 
      '<span class="fas fa-sync-alt fa-spin me-2"></span>Processing...';
  });
});
</script>

<style>
.border-dashed {
  border: 2px dashed #dee2e6;
  cursor: pointer;
}

.border-dashed:hover {
  border-color: #0d6efd;
  background-color: rgba(13, 110, 253, 0.05);
}
</style>