<script>
  // Simple session timer - similar to original
  document.addEventListener('DOMContentLoaded', () => {
    // Simple timer display - just show static time
    const timerElement = document.createElement('div');
    timerElement.className = 'text-end text-500 fs-9 mb-2';
    timerElement.innerHTML = '<i class="fas fa-clock me-1"></i>Session active';
    
    // Add to card header or appropriate place
    const cardHeader = document.querySelector('.card-header');
    if (cardHeader) {
      const timerContainer = document.createElement('div');
      timerContainer.className = 'col-12';
      timerContainer.appendChild(timerElement);
      
      const headerRow = cardHeader.querySelector('.row');
      if (headerRow) {
        headerRow.parentNode.insertBefore(timerContainer, headerRow.nextSibling);
      }
    }
  });
</script>