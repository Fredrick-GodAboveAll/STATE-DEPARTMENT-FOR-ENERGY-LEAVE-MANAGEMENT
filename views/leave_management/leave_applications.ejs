        </div>
      </div>
    </div>
  </div>
  
  <div class="col-md-3 col-6">
    <div class="card border-start border-3 border-warning h-100">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
          <div class="flex-1">
            <h6 class="text-600 mb-1">Capacity</h6>
