<!-- Bulk Upload Modal -->
<div class="modal fade" id="bulkUploadModal" tabindex="-1" aria-labelledby="bulkUploadModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="bulkUploadModalLabel">Bulk Upload Leave Types</h5>
        <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
          <span class="fas fa-times fs-9"></span>
        </button>
      </div>
      <form id="bulkUploadForm" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="alert alert-info">
            <h6 class="alert-heading mb-2"><i class="fas fa-info-circle me-2"></i>Instructions</h6>
            <ul class="mb-0">
              <li>Download the template file and fill in your leave types</li>
              <li>Required columns: <code>leave_name</code>, <code>entitled_days</code></li>
              <li>Optional columns: <code>color</code>, <code>gender_restriction</code>, <code>description</code>, <code>status</code></li>
              <li>Max file size: 5MB</li>
            </ul>
          </div>
          
          <div class="mb-4 text-center">
            <a href="/leave_types/template" class="btn btn-outline-success btn-sm" id="downloadTemplateBtn">
              <span class="fas fa-download me-2"></span>Download CSV Template
            </a>
          </div>
          
          <div class="mb-3">
            <label class="form-label" for="csvFile">Upload CSV File *</label>
            <div class="file-drop-area" id="fileDropArea">
              <span class="file-msg">Drag & drop your CSV file here or click to browse</span>
              <input class="file-input" id="csvFile" type="file" name="csvFile" accept=".csv" required>
            </div>
            <div class="form-text">Select a CSV file containing leave type data</div>
            <div id="fileName" class="mt-2 text-success fw-semi-bold d-none"></div>
          </div>
          
          <div class="progress mb-3 d-none" id="uploadProgress">
            <div class="progress-bar progress-bar-striped progress-bar-animated" 
                 role="progressbar" 
                 style="width: 0%"
                 aria-valuenow="0" 
                 aria-valuemin="0" 
                 aria-valuemax="100">
              0%
            </div>
          </div>
          
          <div id="uploadResult" class="d-none">
            <div class="alert alert-success" id="successResult">
              <h6 class="alert-heading mb-2"><i class="fas fa-check-circle me-2"></i>Upload Successful</h6>
              <p class="mb-2" id="successMessage"></p>
              <div id="successDetails"></div>
            </div>
