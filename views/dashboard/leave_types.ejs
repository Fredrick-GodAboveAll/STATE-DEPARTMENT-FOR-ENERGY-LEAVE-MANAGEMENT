<!-- Leave Type Summary Cards -->
<div class="row mb-4 g-3">
  <div class="col-md-3 col-6">
    <div class="card border-start border-3 border-primary h-100">
      <div class="card-body p-3">
        <div class="d-flex align-items-center">
