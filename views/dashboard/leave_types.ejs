          <div class="flex-1">
            <h6 class="text-600 mb-1">Female Only</h6>
            <% 
              const femaleLeaveTypes = leaveTypes ? leaveTypes.filter(lt => lt.gender_restriction === 'Female').length : 0;
            %>
            <h4 class="mb-0"><%= femaleLeaveTypes %></h4>
          </div>
